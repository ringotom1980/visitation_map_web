APP_NAME="遺眷親訪地圖"
APP_ENV=local

APP_BASE_URL="/visitation_map_web/Public"

DB_HOST="localhost"
DB_NAME="visitation_map"
DB_USER="your_db_user"
DB_PASS="your_db_password"
DB_CHARSET="utf8mb4"

# 地圖供應商：google 或 maplibre
MAP_PROVIDER="maplibre"

# Google Maps 備援用；MAP_PROVIDER=google 時才需要
GOOGLE_MAPS_API_KEY=""

# MapLibre + MapTiler 用；MAP_PROVIDER=maplibre 時需要
MAPTILER_API_KEY="your_maptiler_api_key"
MAPTILER_STYLE_URL=""

# 登入後裝置 Email OTP 驗證。預設關閉，避免使用者頻繁被要求驗證。
AUTH_DEVICE_OTP_ENABLED=false
